load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The static library of zlib's CMake build (zlibstatic).
cc_library(
    name = "zlib",
    srcs = [
        "adler32.c",
        "compress.c",
        "crc32.c",
        "crc32.h",
        "deflate.c",
        "deflate.h",
        "gzclose.c",
        "gzguts.h",
        "gzlib.c",
        "gzread.c",
        "gzwrite.c",
        "infback.c",
        "inffast.c",
        "inffast.h",
        "inffixed.h",
        "inflate.c",
        "inflate.h",
        "inftrees.c",
        "inftrees.h",
        "trees.c",
        "trees.h",
        "uncompr.c",
        "zutil.c",
        "zutil.h",
    ],
    hdrs = [
        "zconf.h",
        "zlib.h",
    ],
    copts = ["-w"],
    includes = ["."],
    local_defines = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["Z_HAVE_UNISTD_H"],
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "z",
    actual = ":zlib",
    visibility = ["//visibility:public"],
)
