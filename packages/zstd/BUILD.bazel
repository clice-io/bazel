load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The static library of zstd's CMake build, multithreaded. The x86-64
# assembly of the Huffman decoder is ELF and Mach-O only; on Windows the C
# decoder takes its place, as with MSVC.
cc_library(
    name = "zstd",
    srcs = glob([
        "lib/common/*.c",
        "lib/common/*.h",
        "lib/compress/*.c",
        "lib/compress/*.h",
        "lib/decompress/*.c",
        "lib/decompress/*.h",
        "lib/dictBuilder/*.c",
        "lib/dictBuilder/*.h",
    ]) + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["lib/decompress/huf_decompress_amd64.S"],
    }),
    hdrs = [
        "lib/zdict.h",
        "lib/zstd.h",
        "lib/zstd_errors.h",
    ],
    copts = ["-w"],
    includes = ["lib"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-pthread"],
    }),
    local_defines = [
        "XXH_NAMESPACE=ZSTD_",
        "ZSTD_MULTITHREAD",
    ] + select({
        "@platforms//os:windows": ["ZSTD_DISABLE_ASM"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
