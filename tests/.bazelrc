# The packages' tests: xclang's toolchain, from this registry, and the
# packages themselves from their archives (scripts/package.ts test).
common --registry=https://bazel.clice.io/
common --registry=https://bcr.bazel.build/
common --enable_platform_specific_config
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
test --test_output=errors
common:windows --enable_runfiles
